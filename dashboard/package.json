{
  "name": "sdr-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live progress board for the SDR pipeline. Reads prospects/ markdown as the source of truth.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-data.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
